[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 100)
    origin = top-right
    offset = (10, 50)
    padding = 14
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    corner_radius = 10
    gap_size = 6

    font = JetBrainsMono Nerd Font 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = end

    icon_position = left
    max_icon_size = 48

    idle_threshold = 120
    show_age_threshold = 60
    sticky_history = yes
    history_length = 20

    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#565f89"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"

[urgency_critical]
    background = "#1a1b26"
    foreground = "#ff9e64"
    frame_color = "#f7768e"
    timeout = 0
